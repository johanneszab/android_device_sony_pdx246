<!--
    target-level is the Shipping FCM Version of the *vendor* implementation,
    not the system. Sony's own vendor/etc/vintf/manifest_parrot.xml and
    manifest_ravelin.xml declare target-level="6", and the blobs serve the
    FCM 6 generation of HALs (gnss@2.1, thermal@2.0, usb@1.2, composer@2.4,
    allocator@4.0), so anything newer fails the deprecation check.

    Most HALs are declared by the per-service fragments the blobs ship in
    vendor/etc/vintf/manifest/. The ones below cannot be: AOSP (or
    vendor/qcom/opensource) defines a module that installs a fragment to the
    same path, so shipping the stock copy is a duplicate-rule error in kati,
    but those source modules are not in PRODUCT_PACKAGES, so their fragment
    never actually lands and the HAL ends up undeclared. Declaring them here
    avoids the path collision entirely. The implementations are the Sony blobs
    in vendor/bin/hw.
-->
<manifest version="1.0" type="device" target-level="6">
    <hal format="hidl">
        <name>android.hardware.atrace</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IAtraceDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.biometrics.fingerprint</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IBiometricsFingerprint</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.cas</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IMediaCasService</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- NO android.hardware.audio.core here on purpose.
         It used to declare IModule/usb, which the com.android.hardware.audio
         apex omitted. That apex is gone: audio is now the QTI AIDL HAL built
         from source, and libaudiocorehal.default ships its own fragment
         (manifest_audiocorehal_default.xml) declaring IConfig/default,
         IModule/default, IModule/r_submix AND IModule/usb. Declaring usb here
         as well makes checkvintf fail the build:
           VINTF parse error: Cannot add manifest fragment
           manifest_audiocorehal_default.xml: HAL "android.hardware.audio.core"
           has a conflict: Conflicting FqInstance
         Same trap as the soundtrigger vintf_fragment earlier: if the module
         ships its own fragment, do not also declare it here. -->
    <!-- Stock HIDL audio HAL (vendor/bin/hw/android.hardware.audio.service_64).
         frameworks/av/media/libaudiohal/FactoryHal.cpp falls back from AIDL to
         HIDL 7.1/7.0/6.0 and looks up exactly these two:
             HIDL devices -> android.hardware.audio        / IDevicesFactory
             HIDL effects -> android.hardware.audio.effect / IEffectsFactory
         The service binary ships no VINTF fragment of its own, so unlike the
         AGM/PAL services these DO have to be declared here. -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <version>7.0</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <version>7.0</version>
        <interface>
            <name>IEffectsFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
