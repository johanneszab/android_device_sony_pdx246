<resources>
    <!-- Auxiliary cameras, as on pdx257. The back cameras are 0 (main,
         4.71 mm) and 2 (ultra-wide, 1.65 mm); 3 and 4 are logical cameras over
         0 and 2, which Aperture ignores by default
         (config_ignoreLogicalAuxCameras). Camera 2 used to be listed in
         config_ignoredAuxCameraIds, from the first adjustments, before any
         test on the phone. -->
    <bool name="config_enableAuxCameras">true</bool>
</resources>

