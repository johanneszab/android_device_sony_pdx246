<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds.  Do not translate.

     NOTE: The naming convention is "config_camelCaseValue". Some legacy
     entries do not follow the convention, but all new entries should. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- An array of arrays of side fingerprint sensor properties relative to each display.
         Note: this value is temporary and is expected to be queried directly
         from the HAL in the future. -->
    <array name="config_sfps_sensor_props" translatable="false">
        <item>@array/config_sfps_sensor_props_0</item>
    </array>

    <!-- displayId is this panel's uniqueId (dumpsys display).
         BEWARE: despite the field name, SystemUI reads sensorLocationY as the
         TOP EDGE of a strip 2*sensorRadius long, not as the centre. See
         SideFpsSensorInteractor, where it becomes `sensorTop` and rotation 180
         mirrors it as (displayHeight minus sensorLocationY minus the length). It
         positions both the enrolment progress bar and the unlock indicator.
         (SensorLocationInternal.getRect() does treat it as a centre, but
         nothing on this path calls that.) Feeding it stock's centre value drew
         the enrolment bar a full radius too low.
         The numbers were calibrated on the device. The panel is 2520 px over
         142.4 mm (6.1", 21:9, ~449 ppi) = 17.7 px/mm, and the sensor measures
         14 mm, so the radius is 124 px and the strip is 248 px long. The centre
         was calibrated by eye against the power key, in three steps: at 1442
         (stock's 1202 mistakenly read as a centre) the bar sat low; at 1167
         (1202 minus the 2 mm the sensor measures above the middle of the key)
         it sat 2 mm high, so that physical offset does not carry into screen
         coordinates, since the lit-pixel edge is not the coordinate origin; at 1202
         it covered the sensor but still sat marginally high, and 9 px lower
         still left it a little high. Two such steps, 18 px or 1 mm below
         stock's value, put it on the sensor: the centre is 1220 and the top
         edge 1220 minus 124 = 1096. One px here is 0.056 mm, so a step of this
         size is about the smallest that can be judged by eye.
         The SystemUI dimen physical_fingerprint_sensor_center_screen_location_y
         deliberately stays at stock's 1202px: it anchors the unlock ripple,
         which is a large radial animation that 9 px does not move visibly, and
         leaving it means that file keeps stock's values only.
         Stock sets no sfps array at all, and neither do pdx235 and pdx257, so
         there is nothing to copy here. -->
    <array name="config_sfps_sensor_props_0" translatable="false">
        <item>local:4630946227116744066</item> <!--item>displayId</item-->
        <item>1080</item> <!--item>sensorLocationX</item-->
        <item>1096</item> <!--item>sensorLocationY</item-->
        <item>124</item> <!--item>sensorRadius</item-->
    </array>

    <!-- The fingerprint sensor is in the power key. The HIDL 2.1 HAL cannot
         report its type, so without this the framework registers it as a rear
         sensor: rear-sensor enrollment texts, and a power-key press ends an
         enrollment or BiometricPrompt. Stock's product RRO sets it. -->
    <bool name="config_is_powerbutton_fps">true</bool>

    <!-- The fingerprint HAL is HIDL (android.hardware.biometrics.fingerprint@2.1).
         AuthService registers a HIDL sensor only if it is listed here, as
         "id:modality:strength". Stock's FrameworksResTarget_Vendor.apk uses
         sensor 0, modality 2 (fingerprint), strength 15 (BIOMETRIC_STRONG). -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>

    <!-- IMS: VoLTE and Wi-Fi calling through the QTI ImsService
         (org.codeaurora.ims, named in SonyPDX246TelephonyRes). Values from stock
         FrameworksResCommon_Sys.apk, except video calling, which stock's EEA
         product overlay turns off. Whether a SIM then gets VoLTE or Wi-Fi calling
         is up to the carrier config (SonyPDX246CarrierConfig). -->
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_carrier_volte_available">true</bool>
    <bool name="config_device_vt_available">false</bool>
    <bool name="config_device_wfc_ims_available">true</bool>

    <!-- IWLAN, the transport for Wi-Fi calling. vendor.qti.iwlan provides the
         IWLAN data and network services and the qualified networks service.
         AOSP leaves these empty, and then Telephony binds none of them: every
         transport stays WWAN and IMS never registers over Wi-Fi. Values from
         stock FrameworksResCommon_Sys.apk; pdx257 sets the same. -->
    <string name="config_wlan_data_service_package" translatable="false">vendor.qti.iwlan</string>
    <string name="config_wlan_network_service_package" translatable="false">vendor.qti.iwlan</string>
    <string name="config_qualified_networks_service_package" translatable="false">vendor.qti.iwlan</string>

    <!-- Wired headset detection. The kernel reports the 3.5 mm jack through the
         input device "parrot-qrd-sku1-snd-card Headset Jack" (SW_HEADPHONE_INSERT,
         SW_MICROPHONE_INSERT, SW_LINEOUT_INSERT). With the AOSP default (false),
         WiredAccessoryManager waits for /sys/class/switch/h2w instead, which this
         kernel does not have, so headphones were never routed. Stock sets true. -->
    <bool name="config_useDevInputEventForAudioJack" translatable="false">true</bool>

    <!-- Pin the fused location provider to AOSP com.android.location.fused.

         With the overlay enabled, the service watcher picks the system app with
         the highest serviceVersion for the fused action. com.qualcomm.location
         (izat) declares 1, AOSP FusedLocation declares 0, so izat took the slot.
         izat is not usable as the fused provider on this build:
           - it holds no location runtime permissions, so it snaps every report
             to a 2 km grid (FlpServiceProvider: Has ACCESS_FINE_LOCATION
             permission: false; reports arrive with hAcc=2000.0)
           - its FLP session handling fails on a browser burst of requests
             (Invalid FlpSession id, LocSvc_APIClientBase ERROR: 5)
           - it produced no reports unless another client had GNSS running
         Stock never uses it either: there Google Play Services is the fused
         provider. On stock-less builds like this one it simply broke location
         for apps such as Jelly.

         AOSP FusedLocation forwards HIGH_ACCURACY requests to the gps provider.
         Verified 2026-09-10: Jelly got a real gps fix (hAcc 8.9 m) through it.
         With this false, CurrentUserServiceSupplier.retrieveExplicitPackage()
         returns config_fusedLocationProviderPackageName, which is AOSP's.
         See the notes repo, "FIXED (2026-09-10): websites got no location". -->
    <bool name="config_enableFusedLocationOverlay" translatable="false">false</bool>

