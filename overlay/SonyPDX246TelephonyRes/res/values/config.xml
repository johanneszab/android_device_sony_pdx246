<!-- Values from stock pdx246's TelephonyResCommon_Sys.apk, the same set that
     device/sony/pdx257 ships as source. Without config_ims_mmtel_package no
     ImsService is bound for voice, so calls never use VoLTE or Wi-Fi calling:
     `cmd phone ims get-ims-service -s 0 -d` printed nothing. -->
<resources>
    <!-- Determine whether we should show the "listen for instructions" screen after
         successfully placing the OTA call -->
    <integer name="OtaShowListeningScreen">1</integer>

    <!-- Flag indicating if the phone is a world phone -->
    <bool name="world_phone">true</bool>

    <!-- Flag indicating if dtmf tone type is enabled -->
    <bool name="dtmf_type_enabled">true</bool>

    <!-- Route microphone mute through android.media.AudioManager -->
    <bool name="send_mic_mute_to_AudioManager">true</bool>

    <!-- Let the SIM's Customer Service Profile restrict manual operator selection -->
    <bool name="csp_enabled">true</bool>

    <!-- Flag indicating whether the device supports RTT (real-time text) -->
    <bool name="config_support_rtt">true</bool>

    <!-- Package name of the device ImsService implementation for MMTEL -->
    <string name="config_ims_mmtel_package" translatable="false">org.codeaurora.ims</string>

    <!-- Package name of the device ImsService implementation for RCS -->
    <string name="config_ims_rcs_package" translatable="false">vendor.qti.imsrcs</string>

    <!-- Whether the device supports dialing emergency RTT calls without a SIM -->
    <bool name="config_support_simless_emergency_rtt">true</bool>

    <!-- Package name of the device GbaService implementation -->
    <string name="config_gba_package" translatable="false">com.qualcomm.qti.uimGbaApp</string>
</resources>
