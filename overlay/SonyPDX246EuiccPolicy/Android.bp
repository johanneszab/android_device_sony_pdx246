// hardware/sony's EuiccPolicySony, which pdx257 installs through SonyEuicc,
// cut down to this device's models. pdx246 does not import the hardware/sony
// Soong namespace (see device.mk, LiveDisplay).
runtime_resource_overlay {
    name: "SonyPDX246EuiccPolicy",
    product_specific: true,
}
