# Stock's rules for tad. hardware/sony/sepolicy declares the domain,
# with its labels and part of stock's rules.

# --- rules ported from stock's odm_sepolicy.cil (tools/selinux-port-stock-rules.py) ---
allow tad block_device:dir { search };
allow tad init:unix_stream_socket { listen accept };
allow tad proc:file { read open };
allow tad tad_block_device:blk_file { ioctl read write open };
allow tad tad_exec:file { read getattr map execute open entrypoint };
allow tad tad_socket:sock_file { write };
allow tad tmpfs:dir { search };
allow tad tmpfs:lnk_file { read };
# --- end of ported rules ---
