# Sony thermal HAL.
#
#   service vendor.semc.hardware.aidlthermal /vendor/bin/hw/vendor.semc.hardware.aidlthermal-service
#
# declared in /vendor/etc/init. Stock uses this type name in
# /odm/etc/selinux/odm_sepolicy.cil, with 32 rules; this file only gives the
# service its domain so far, the rules follow from the permissive denials.
type hal_somc_thermal_daemon, domain;
type hal_somc_thermal_daemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_somc_thermal_daemon)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow hal_somc_thermal_daemon domain:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_somc_thermal_daemon domain:file { ioctl read getattr lock map open watch watch_reads };
allow hal_somc_thermal_daemon domain:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_somc_thermal_daemon dumpstate:binder { transfer };
allow hal_somc_thermal_daemon hal_somc_thermal_daemon_exec:file { read getattr map execute open entrypoint };
allow hal_somc_thermal_daemon hal_somc_thermal_hwservice:hwservice_manager { add find };
allow hal_somc_thermal_daemon hal_somc_thermal_service:service_manager { add find };
allow hal_somc_thermal_daemon hidl_base_hwservice:hwservice_manager { add };
allow hal_somc_thermal_daemon hwservicemanager:binder { call transfer };
allow hal_somc_thermal_daemon hwservicemanager_prop:file { read getattr map open };
allow hal_somc_thermal_daemon init:unix_stream_socket { connectto };
allow hal_somc_thermal_daemon logd:unix_stream_socket { connectto };
allow hal_somc_thermal_daemon logd_socket:sock_file { write };
allow hal_somc_thermal_daemon proc:file { ioctl read getattr lock map open watch watch_reads };
allow hal_somc_thermal_daemon proc_cmdline:file { ioctl read getattr lock map open watch watch_reads };
allow hal_somc_thermal_daemon proc_stat:file { ioctl read getattr lock map open watch watch_reads };
allow hal_somc_thermal_daemon property_socket:sock_file { write };
allow hal_somc_thermal_daemon runtime_event_log_tags_file:file { map };
allow hal_somc_thermal_daemon servicemanager:binder { call transfer };
allow hal_somc_thermal_daemon servicemanager:fd { use };
allow hal_somc_thermal_daemon sysfs:file { write getattr lock append map open };
allow hal_somc_thermal_daemon sysfs_dp_is_stopped:file { write getattr lock append map open };
allow hal_somc_thermal_daemon sysfs_thermal:file { write getattr lock append map open };
allow hal_somc_thermal_daemon vendor_somc_thermal_prop:file { read getattr map open };
allow hal_somc_thermal_daemon vendor_somc_thermal_prop:property_service { set };
allow hal_somc_thermal_daemon vendor_thermal-engine:unix_stream_socket { connectto };
allow hal_somc_thermal_daemon vendor_thermal_socket:sock_file { write };
# --- end of ported rules ---
