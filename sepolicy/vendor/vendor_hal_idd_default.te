# Stock's rules for vendor_hal_idd_default. hardware/sony/sepolicy declares the domain,
# with its labels and part of stock's rules.

# --- rules ported from stock's odm_sepolicy.cil (tools/selinux-port-stock-rules.py) ---
allow vendor_hal_idd_default hal_allocator:fd { use };
allow vendor_hal_idd_default hidl_memory_hwservice:hwservice_manager { find };
allow vendor_hal_idd_default idd:fd { use };
allow vendor_hal_idd_default idd:unix_dgram_socket { sendto };
allow vendor_hal_idd_default idd:unix_stream_socket { connectto };
allow vendor_hal_idd_default idd_data_file:dir { search };
allow vendor_hal_idd_default idd_data_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_idd_default idd_output_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_idd_default idd_output_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_idd_default idd_root_dir:dir { search };
allow vendor_hal_idd_default idd_socket_file:dir { search };
allow vendor_hal_idd_default idd_socket_file:sock_file { write };
allow vendor_hal_idd_default tmpfs:lnk_file { read };
allow vendor_hal_idd_default vendor_hal_idd_default_exec:file { read getattr map execute open entrypoint };
# --- end of ported rules ---
