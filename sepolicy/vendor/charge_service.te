# Sony charge service.
#
#   service charge_service /vendor/bin/charge_service
#       user system
#       group system root oem_2993 wakelock
#       disabled
#
# declared in /odm/etc/init/init.sony-platform.rc. Stock declares the same type
# in /odm/etc/selinux/odm_sepolicy.cil; its rules are ported below.
type charge_service, domain;
type charge_service_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(charge_service)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow charge_service charge_service_exec:file { read getattr map execute open entrypoint };
allow charge_service hidl_manager_hwservice:hwservice_manager { find };
allow charge_service hwservicemanager:binder { call transfer };
allow charge_service hwservicemanager:binder { call };
allow charge_service hwservicemanager_prop:file { read getattr map open };
allow charge_service idd:fd { use };
allow charge_service idd_data_file:dir { search };
allow charge_service idd_data_file:file { read getattr };
allow charge_service idd_root_dir:dir { search };
allow charge_service idd_root_dir:lnk_file { read };
allow charge_service kmsg_device:chr_file { write getattr lock append map open };
allow charge_service mnt_vendor_file:dir { getattr search };
allow charge_service rootfs:lnk_file { getattr };
allow charge_service self:cap2_userns { block_suspend };
allow charge_service self:capability2 { block_suspend };
allow charge_service self:netlink_kobject_uevent_socket { read create bind };
allow charge_service sysfs:dir { read open };
allow charge_service sysfs:file { ioctl read write getattr lock append map open watch watch_reads };
allow charge_service sysfs:file { read getattr open };
allow charge_service sysfs_battchg_ext:dir { ioctl read getattr lock open watch watch_reads search };
allow charge_service sysfs_battchg_ext:file { ioctl read write getattr lock append map open watch watch_reads };
allow charge_service sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow charge_service system_suspend_hwservice:hwservice_manager { find };
allow charge_service system_suspend_server:binder { call transfer };
allow charge_service system_suspend_server:fd { use };
allow charge_service tad:unix_stream_socket { connectto };
allow charge_service tad_socket:sock_file { write };
allow charge_service tmpfs:dir { write };
allow charge_service vendor_hal_idd_default:binder { call };
allow charge_service vendor_hal_idd_hwservice:hwservice_manager { find };
allow charge_service vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow charge_service vendor_sysfs_battery_supply:dir { search };
allow charge_service vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow charge_service vendor_sysfs_battery_supply:file { read write getattr open };
allow charge_service vendor_sysfs_battery_supply:lnk_file { read };
allow charge_service vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow charge_service vendor_sysfs_usb_supply:dir { search };
allow charge_service vendor_sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow charge_service vendor_sysfs_usb_supply:file { read getattr open };
type_transition charge_service system_data_file:dir charge_log_file;
type_transition charge_service system_data_file:file charge_log_file;
# --- end of ported rules ---
