# Sony spcdeld service.
#
#   service spcdeld /vendor/bin/spcdeld
#       user system
#       group system
#       disabled
#
# declared in /odm/etc/init/init.sony-platform.rc. Stock declares the same type
# in /odm/etc/selinux/odm_sepolicy.cil, with 1 rule; this file only gives the
# service its domain so far, the rules follow from the permissive denials.
type spcdeld, domain;
type spcdeld_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(spcdeld)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow spcdeld spcdeld_exec:file { read getattr map execute open entrypoint };
# --- end of ported rules ---
