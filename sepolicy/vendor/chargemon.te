# Sony charge monitor.
#
#   service chargemon /vendor/bin/chargemon
#       user system
#       group root system oem_2993 wakelock input
#       capabilities SYS_BOOT
#       disabled
#
# declared in /odm/etc/init/init.sony-platform.rc. Stock declares the same type
# in /odm/etc/selinux/odm_sepolicy.cil; its rules are ported below.
type chargemon, domain;
type chargemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(chargemon)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow chargemon block_device:dir { search };
allow chargemon chargemon_exec:file { read getattr map execute open entrypoint };
allow chargemon configfs:dir { read write open add_name remove_name search };
allow chargemon configfs:file { read write create getattr open };
allow chargemon configfs:lnk_file { read create unlink };
allow chargemon graphics_device:chr_file { ioctl read write map open };
allow chargemon graphics_device:dir { search };
allow chargemon hidl_manager_hwservice:hwservice_manager { find };
allow chargemon hwservicemanager:binder { call transfer };
allow chargemon hwservicemanager_prop:file { read getattr map open };
allow chargemon input_device:chr_file { ioctl read write open };
allow chargemon input_device:dir { read open search };
allow chargemon ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow chargemon kmsg_device:chr_file { write getattr lock append map open };
allow chargemon labeledfs:filesystem { unmount };
allow chargemon proc:file { read getattr open };
allow chargemon proc_uptime:file { read open };
allow chargemon rootfs:dir { read open };
allow chargemon rootfs:lnk_file { getattr };
allow chargemon self:cap2_userns { block_suspend };
allow chargemon self:capability { sys_boot };
allow chargemon self:capability2 { block_suspend };
allow chargemon sysfs:dir { ioctl read getattr lock open watch watch_reads search };
allow chargemon sysfs:file { read write getattr open };
allow chargemon sysfs_android_usb:dir { search };
allow chargemon sysfs_battchg_ext:dir { ioctl read getattr lock open watch watch_reads search };
allow chargemon sysfs_battchg_ext:file { ioctl read write getattr lock append map open watch watch_reads };
allow chargemon sysfs_devices_system_cpu:dir { ioctl read getattr lock open watch watch_reads search };
allow chargemon sysfs_devices_system_cpu:file { write create };
allow chargemon sysfs_leds:dir { search };
allow chargemon sysfs_leds:file { read write getattr open };
allow chargemon sysfs_leds:lnk_file { read };
allow chargemon sysfs_power:file { write getattr open };
allow chargemon sysfs_switch:dir { search };
allow chargemon sysfs_thermal:file { write };
allow chargemon sysfs_vibrator:file { write getattr open };
allow chargemon sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow chargemon system_data_file:dir { getattr };
allow chargemon system_suspend_hwservice:hwservice_manager { find };
allow chargemon system_suspend_server:binder { call transfer };
allow chargemon system_suspend_server:fd { use };
allow chargemon tad:unix_stream_socket { connectto };
allow chargemon tad_socket:sock_file { write };
allow chargemon tmpfs:dir { search };
allow chargemon tmpfs:filesystem { unmount };
allow chargemon tty_device:chr_file { ioctl read write open };
allow chargemon usbaccessory_device:chr_file { ioctl read write open };
allow chargemon userdata_block_device:blk_file { ioctl read open };
allow chargemon vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow chargemon vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow chargemon vendor_sysfs_battery_supply:file { write };
allow chargemon vendor_sysfs_battery_supply:lnk_file { read };
allow chargemon vendor_sysfs_graphics:dir { search };
allow chargemon vendor_sysfs_graphics:file { read write getattr open };
allow chargemon vendor_sysfs_msm_perf:dir { ioctl read getattr lock open watch watch_reads search };
allow chargemon vendor_sysfs_msm_perf:file { ioctl read write getattr lock append map open watch watch_reads };
allow chargemon vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow chargemon vendor_sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
# --- end of ported rules ---
