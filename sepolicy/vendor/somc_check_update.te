# Sony check_update, one of the storage firmware update (FFU) helpers.
#
#   service check_update /vendor/bin/check_update
#
# declared in /vendor/etc/init/trigger_ffu.rc. Stock uses this type name in
# /odm/etc/selinux/odm_sepolicy.cil, with 14 rules, and makes it a boot control
# HAL client; this file gives the service its domain and that client role, the
# rules follow from the permissive denials.
type somc_check_update, domain;
type somc_check_update_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(somc_check_update)

hal_client_domain(somc_check_update, hal_bootctl)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow somc_check_update hwservicemanager:binder { call transfer };
allow somc_check_update hwservicemanager:fd { use };
allow somc_check_update hwservicemanager_prop:file { read getattr map open };
allow somc_check_update init:unix_stream_socket { connectto };
allow somc_check_update kmsg_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow somc_check_update powerctl_prop:file { read getattr map open };
allow somc_check_update powerctl_prop:property_service { set };
allow somc_check_update property_socket:sock_file { write };
allow somc_check_update somc_check_update_exec:file { read getattr map execute open entrypoint };
allow somc_check_update vendor_somc_ffu_prop:file { read getattr map open };
allow somc_check_update vendor_somc_ffu_prop:property_service { set };
# --- end of ported rules ---
