# Sony Wi-Fi driver HAL.
#
#   service somc_wifidriver_hal_service /vendor/bin/hw/vendor.somc.hardware.wifidriver@2.0-service
#
# declared in /vendor/etc/init. Stock uses this type name in
# /odm/etc/selinux/odm_sepolicy.cil, with 11 rules; this file only gives the
# service its domain so far, the rules follow from the permissive denials.
type hal_somc_wifidriver, domain;
type hal_somc_wifidriver_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_somc_wifidriver)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow hal_somc_wifidriver hal_somc_wifidriver_exec:file { read getattr map execute open entrypoint };
allow hal_somc_wifidriver hal_somc_wifidriver_hwservice:hwservice_manager { add find };
allow hal_somc_wifidriver hidl_base_hwservice:hwservice_manager { add };
allow hal_somc_wifidriver hwservicemanager:binder { call transfer };
allow hal_somc_wifidriver hwservicemanager_prop:file { read getattr map open };
allow hal_somc_wifidriver self:capability { net_admin net_raw };
allow hal_somc_wifidriver self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_somc_wifidriver self:netlink_kobject_uevent_socket { read create bind getopt setopt };
allow hal_somc_wifidriver self:udp_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_somc_wifidriver sony_wlan_data_file:file { read getattr open };
# --- end of ported rules ---
