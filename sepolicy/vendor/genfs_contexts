# Stock's genfscon from /odm/etc/selinux/odm_sepolicy.cil; type in stock_types.te.
genfscon sysfs /devices/drm_dp/dp_is_stopped u:object_r:sysfs_dp_is_stopped:s0

# Stock's genfscon for Sony's HardwareInfo sensor nodes, from
# /vendor/etc/selinux/vendor_sepolicy.cil; types in hal_sensors_default.te.
genfscon sysfs /devices/platform/HardwareInfo/gsensor u:object_r:vendor_sysfs_gsensor:s0
genfscon sysfs /devices/platform/HardwareInfo/msensor u:object_r:vendor_sysfs_msensor:s0
genfscon sysfs /devices/platform/HardwareInfo/alsps u:object_r:vendor_sysfs_alsps:s0
genfscon sysfs /devices/platform/HardwareInfo/gyro u:object_r:vendor_sysfs_gyro:s0

# Wakeup sources at board-specific device paths that neither QTI's parrot list
# nor Sony's shared policy labels, so system_suspend and system_server could
# not read their statistics (stock denies those reads too): the NXP NFC
# controller (nxp,sn-nci), the Wi-Fi (icnss2) and a QUP serial port
# (msm_geni_serial).
genfscon sysfs /devices/platform/soc/a80000.i2c/i2c-2/2-0028/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/22800000.qcom,icnss/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/a94000.qcom,qup_uart/wakeup u:object_r:sysfs_wakeup:s0

# The WCD937x codec's extcon device (headset jack detection). AOSP labels only
# /class/extcon as sysfs_extcon; the device directory its symlinks point to
# stayed plain sysfs, so system_server's ExtconUEventObserver could not read
# the cable names (4 denials per boot and a logged exception).
genfscon sysfs /devices/platform/soc/soc:spf_core_platform/soc:spf_core_platform:lpass-cdc/wcd937x-codec/extcon u:object_r:sysfs_extcon:s0
