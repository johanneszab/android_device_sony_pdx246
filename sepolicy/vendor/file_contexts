# Labels for the Sony/QTI HAL binaries this device ships whose names are not
# matched by any upstream file_contexts entry. Without a match they fall through
# to the generic u:object_r:vendor_file:s0, init reports
#   "has incorrect label or no domain transition from u:r:init:s0"
# and the service never gets a domain.
#
# Each is mapped to the standard AOSP exec type for its HAL, all of which are
# already defined in the merged policy.

# Sony variants of standard HALs
# NOTE: the face HAL is no longer extracted (see proprietary-files.txt).
# This label is inert but kept so re-adding the blob just works.
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.face@1\.0-service\.face  u:object_r:hal_face_default_exec:s0

# Sony-specific daemons that have no upstream type at all (unlike the entries
# above, which reuse an existing AOSP exec type). Domains declared in
# tad.te / ta_qmi_service.te / mlog_qmi_service.te / somc_wifi_idd_hal_service.te.
/(vendor|system/vendor)/bin/tad                                                u:object_r:tad_exec:s0
/(vendor|system/vendor)/bin/wait4tad                                           u:object_r:tad_exec:s0
/(vendor|system/vendor)/bin/ta_qmi_service                                     u:object_r:ta_qmi_service_exec:s0
/(vendor|system/vendor)/bin/mlog_qmi_service                                   u:object_r:mlog_qmi_service_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.somc\.hardware\.wifi\.idd-service       u:object_r:somc_wifi_idd_hal_service_exec:s0

# init creates this for the tad service (socket tad stream 0660 system oem_2993)
/dev/socket/tad                                                                u:object_r:tad_socket:s0
