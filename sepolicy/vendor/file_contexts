# Labels for the Sony/QTI HAL binaries this device ships whose names are not
# matched by any upstream file_contexts entry. Without a match they fall through
# to the generic u:object_r:vendor_file:s0, init reports
#   "has incorrect label or no domain transition from u:r:init:s0"
# and the service never gets a domain.
#
# Each is mapped to the standard AOSP exec type for its HAL, all of which are
# already defined in the merged policy.

# Sony variants of standard HALs
# NOTE: the face HAL is no longer extracted (see proprietary-files.txt).
# This label is inert but kept so re-adding the blob just works.
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.face@1\.0-service\.face  u:object_r:hal_face_default_exec:s0

# Sony-specific daemons that have no upstream type at all (unlike the entry
# above, which reuses an existing AOSP exec type). tad, ta_qmi_service,
# mlog_qmi_service and /dev/socket/tad are labelled by hardware/sony/sepolicy/qti
# (included in BoardConfig.mk). It does not label wait4tad, which init runs with
# seclabel u:r:tad:s0; stock labels it tad_exec as well.
/(vendor|system/vendor)/bin/wait4tad                                           u:object_r:tad_exec:s0
# Domain declared in somc_wifi_idd_hal_service.te.
/(vendor|system/vendor)/bin/hw/vendor\.somc\.hardware\.wifi\.idd-service       u:object_r:somc_wifi_idd_hal_service_exec:s0

# Sony services that stock labels in /odm/etc/selinux/odm_file_contexts and
# hardware/sony/sepolicy does not. The lines are stock's; each type is declared
# in the .te file of the same name.
/(vendor|system/vendor)/bin/charge_service       u:object_r:charge_service_exec:s0
/(vendor|system/vendor)/bin/chargemon            u:object_r:chargemon_exec:s0
/(vendor|system/vendor|odm|vendor/odm)/bin/check_ffu              u:object_r:somc_check_ffu_exec:s0
/(vendor|system/vendor|odm|vendor/odm)/bin/check_update           u:object_r:somc_check_update_exec:s0
/(vendor|system/vendor)/bin/pip_firewall                      u:object_r:pip_firewall_exec:s0
/(vendor|system/vendor)/bin/pmic_key_reset u:object_r:pmic_key_reset_exec:s0
/(vendor|system/vendor|odm|vendor/odm)/bin/spcdeld                                u:object_r:spcdeld_exec:s0
/(vendor|system/vendor|odm|vendor/odm)/bin/hw/vendor\.semc\.hardware\.aidlcharger-service\.somc u:object_r:hal_somc_charger_daemon_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.semc\.hardware\.charger@(.*)? u:object_r:hal_somc_charger_daemon_exec:s0
/(vendor|odm|vendor/odm)/bin/hw/vendor\.semc\.hardware\.aidlthermal-service u:object_r:hal_somc_thermal_daemon_exec:s0
/(vendor|system/vendor|odm|vendor/odm)/bin/hw/vendor\.somc\.hardware\.aidlsuperstamina-service u:object_r:hal_superstamina_exec:s0
/vendor/bin/hw/vendor\.somc\.hardware\.wifidriver@[1-9]\.[0-9]-service u:object_r:hal_somc_wifidriver_exec:s0

# Stock labels these with existing AOSP types (vendor_file_contexts and
# odm_file_contexts).
/(vendor|system/vendor)/bin/hw/android\.hardware\.secure_element_snxxx@1\.2-service       u:object_r:hal_secure_element_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.sony\.tsr\.media\.c2\-service u:object_r:mediacodec_exec:s0
/(vendor|system/vendor|odm|vendor/odm)/bin/trigger_ffu            u:object_r:vendor_misc_writer_exec:s0

# A/B partitions that stock labels in vendor_file_contexts and QTI's list does
# not (stock's lines). The boot control HAL stats every *_a partition when it
# updates the GPT slot attributes. QTI's hal_bootctl.te lets it getattr
# system_block_device, but an unlabeled block_device was denied ("Unable to
# stat block device: .../oem_a, Permission denied").
/dev/block/platform/soc/1d84000.ufshc/by-name/oem_[ab]              u:object_r:system_block_device:s0
/dev/block/platform/soc/1d84000.ufshc/by-name/system_ext_[ab]      u:object_r:system_block_device:s0

# Files that stock's rules for the Sony domains use (stock's lines from
# odm_file_contexts; types in stock_types.te).
/data/vendor/charge_log(/.*)?                    u:object_r:charge_log_file:s0
/mnt/vendor/persist/charge_log(/.*)?             u:object_r:charge_log_file:s0
/sys/devices/platform/soc/1d84000.ufshc/host0/target0:0:0/0:0:0:0/model u:object_r:sysfs_scsi_dev_model:s0
/sys/devices/platform/soc/1d84000.ufshc/host0/target0:0:0/0:0:0:0/rev u:object_r:sysfs_scsi_dev_rev:s0
