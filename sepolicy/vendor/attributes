# HAL attributes of Sony's charger and Wi-Fi IDD HALs. Stock declares
# hal_somc_charger and hal_somc_charger_server in /odm/etc/selinux/odm_sepolicy.cil,
# and hal_somc_wifi_idd with its _client and _server sets in its /product policy
# (product_sepolicy.cil; /vendor carries them in plat_pub_versioned.cil).
# hal_attribute() also declares hal_somc_charger_client, which stock does not have.
# The servers are made members, with stock's rules for the attributes, in
# hal_somc_charger_daemon.te and somc_wifi_idd_hal_service.te.
hal_attribute(somc_charger)
hal_attribute(somc_wifi_idd)
