# Sony TA QMI bridge -- exposes Trim Area data over QMI.
#
#   service ta_qmi_service /system/vendor/bin/ta_qmi_service
#       user root
#       seclabel u:r:ta_qmi_service:s0
#       disabled
#
# See tad.te for why declaring the type is required even under global
# permissive.
type ta_qmi_service, domain;
type ta_qmi_service_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(ta_qmi_service)
