# Stock's rules for ta_qmi_service. hardware/sony/sepolicy declares the domain,
# with its labels and part of stock's rules.

# --- rules ported from stock's odm_sepolicy.cil (tools/selinux-port-stock-rules.py) ---
allow ta_qmi_service hidl_manager_hwservice:hwservice_manager { find };
allow ta_qmi_service hwservicemanager:binder { call transfer };
allow ta_qmi_service hwservicemanager_prop:file { read getattr map open };
allow ta_qmi_service self:cap2_userns { block_suspend };
allow ta_qmi_service self:capability { setgid setuid net_bind_service net_raw };
allow ta_qmi_service self:capability2 { block_suspend };
allow ta_qmi_service self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow ta_qmi_service self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow ta_qmi_service sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow ta_qmi_service system_suspend_hwservice:hwservice_manager { find };
allow ta_qmi_service system_suspend_server:binder { call transfer };
allow ta_qmi_service system_suspend_server:fd { use };
allow ta_qmi_service ta_qmi_service_exec:file { read getattr map execute open entrypoint };
allow ta_qmi_service tad:unix_stream_socket { connectto };
allow ta_qmi_service tad_socket:sock_file { write };
# --- end of ported rules ---
