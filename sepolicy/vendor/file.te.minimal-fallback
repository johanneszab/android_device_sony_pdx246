# Types referenced by rootdir/etc/fstab.default in its context= mount options.
#
# These are QTI types that AOSP and device/lineage/sepolicy do not define, so
# without them the kernel rejects the mounts outright:
#   SELinux: security_context_str_to_sid(u:object_r:bt_firmware_file:s0) failed
#            for (dev sda68, type vfat) errno=-22
#   init: [libfs_mgr] Failed to mount ... by-name/modem_a at /vendor/firmware_mnt
# This is not a permissive-mode denial -- an undefined type makes the mount
# option itself invalid, so permissive does not help.
#
# contextmount_type is the attribute that makes a type usable in a context=
# mount option; that is the part that matters here. Declared the same way
# device/qcom/sepolicy_vndr/sm8450/generic/vendor/common/file.te does, minus the
# QTI-specific attributes, so we do not need the whole QTI policy (which does
# not currently build against Android 16 -- see PORTING-NOTES.md).

# /vendor/firmware_mnt  <- by-name/modem     (modem, IPA and related firmware)
type firmware_file, file_type, contextmount_type, vendor_file_type;

# /vendor/bt_firmware   <- by-name/bluetooth
type bt_firmware_file, file_type, contextmount_type, vendor_file_type;

# /mnt/vendor/qmcs      <- by-name/qmcs
type vendor_qmcs_file, file_type, contextmount_type, vendor_file_type;
