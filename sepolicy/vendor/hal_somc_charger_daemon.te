# Sony charger HAL, both the AIDL and the HIDL 1.2 service.
#
#   service vendor.aidlcharger-somc /vendor/bin/hw/vendor.semc.hardware.aidlcharger-service.somc
#   service vendor.semc.hardware.charger-1-2 /vendor/bin/hw/vendor.semc.hardware.charger@1.2-service
#
# declared in /vendor/etc/init. Stock uses this type name in
# /odm/etc/selinux/odm_sepolicy.cil, with 23 rules and its own hal_somc_charger
# attributes; this file only gives the services their domain so far, the rules
# and attributes follow with the permissive denials.
type hal_somc_charger_daemon, domain;
type hal_somc_charger_daemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_somc_charger_daemon)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow hal_somc_charger_daemon dumpstate:binder { transfer };
allow hal_somc_charger_daemon hal_somc_charger_daemon_exec:file { read getattr map execute open entrypoint };
allow hal_somc_charger_daemon hal_somc_charger_hwservice:hwservice_manager { add find };
allow hal_somc_charger_daemon hal_somc_charger_service:service_manager { add find };
allow hal_somc_charger_daemon hidl_base_hwservice:hwservice_manager { add };
allow hal_somc_charger_daemon init:unix_stream_socket { connectto };
allow hal_somc_charger_daemon property_socket:sock_file { write };
allow hal_somc_charger_daemon self:netlink_kobject_uevent_socket { read create bind getopt setopt };
allow hal_somc_charger_daemon sysfs:dir { search };
allow hal_somc_charger_daemon sysfs:file { read write getattr open };
allow hal_somc_charger_daemon sysfs_battchg_ext:dir { search };
allow hal_somc_charger_daemon sysfs_battchg_ext:file { read getattr open };
allow hal_somc_charger_daemon tad:unix_stream_socket { connectto };
allow hal_somc_charger_daemon tad_socket:sock_file { write };
allow hal_somc_charger_daemon vendor_hal_somc_charger_prop:file { read getattr map open };
allow hal_somc_charger_daemon vendor_hal_somc_charger_prop:property_service { set };
allow hal_somc_charger_daemon vendor_sysfs_battery_supply:dir { search };
allow hal_somc_charger_daemon vendor_sysfs_battery_supply:file { write getattr open };
# --- end of ported rules ---
