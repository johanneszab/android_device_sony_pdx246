# Sony STAMINA mode HAL.
#
#   service vendor.aidlsuperstamina-somc /vendor/bin/hw/vendor.somc.hardware.aidlsuperstamina-service
#
# declared in /vendor/etc/init. Stock uses this type name in
# /odm/etc/selinux/odm_sepolicy.cil, with 19 rules; this file only gives the
# service its domain so far, the rules follow from the permissive denials.
type hal_superstamina, domain;
type hal_superstamina_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_superstamina)
