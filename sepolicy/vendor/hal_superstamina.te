# Sony STAMINA mode HAL.
#
#   service vendor.aidlsuperstamina-somc /vendor/bin/hw/vendor.somc.hardware.aidlsuperstamina-service
#
# declared in /vendor/etc/init. Stock uses this type name in
# /odm/etc/selinux/odm_sepolicy.cil, with 19 rules; this file only gives the
# service its domain so far, the rules follow from the permissive denials.
type hal_superstamina, domain;
type hal_superstamina_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_superstamina)

# --- rules ported from stock's odm_sepolicy.cil (build-logs/selinux-port-stock-rules.py) ---
allow hal_superstamina dumpstate:binder { transfer };
allow hal_superstamina hal_somc_superstamina_hwservice:hwservice_manager { add find };
allow hal_superstamina hal_somc_superstamina_service:service_manager { add find };
allow hal_superstamina hal_superstamina_exec:file { read getattr map execute open entrypoint };
allow hal_superstamina hidl_base_hwservice:hwservice_manager { add };
allow hal_superstamina hwservicemanager:binder { call transfer };
allow hal_superstamina hwservicemanager_prop:file { read getattr map open };
allow hal_superstamina init:unix_stream_socket { connectto };
allow hal_superstamina property_socket:sock_file { write };
allow hal_superstamina servicemanager:binder { call transfer };
allow hal_superstamina servicemanager:fd { use };
allow hal_superstamina sysfs:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_superstamina sysfs_thermal:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_superstamina vendor_hal_superstamina_prop:file { read getattr map open };
allow hal_superstamina vendor_hal_superstamina_prop:property_service { set };
# --- end of ported rules ---
