diff --git a/ar_osal/Android.bp b/ar_osal/Android.bp
index 656aafe..c9f5781 100644
--- a/ar_osal/Android.bp
+++ b/ar_osal/Android.bp
@@ -9,6 +9,17 @@ cc_library_shared {
     owner: "qti",
     vendor: true,
 
+    // 64-bit only, added for device/sony/pdx246. This is the one audio source
+    // module compiled against the kernel UAPI headers, and pdx246 has a second
+    // arch (TARGET_2ND_ARCH := arm; stock runs zygote64_32 and ~100 vendor
+    // blobs are 32-bit only, so it cannot be dropped). LineageOS's
+    // generated_kernel_includes exports the kernel's arm64 usr/include for BOTH
+    // arches, and -I beats bionic's -isystem asm-arm, so the 32-bit build picks
+    // up arm64's asm/sigcontext.h and dies on:
+    //     error: unknown type name '__uint128_t'
+    // pdx257 never hits this because it is 64-bit only.
+    compile_multilib: "64",
+
     cflags: [
         "-D_ANDROID_",
         "-DAR_OSAL_USE_CUTILS",
@@ -34,6 +45,19 @@ cc_library_shared {
     include_dirs: [
         "system/memory/libion/include",
         "system/memory/libion/kernel-headers",
+        // Added for device/sony/pdx246. ar_osal_shmem_db.c needs
+        // <linux/msm_audio.h>. It should arrive via the header_lib
+        // "qti_audio_kernel_uapi", but that name is defined twice: the real one
+        // in kernel/sony/<device>-modules/qcom/opensource/audio-kernel, and a
+        // global alias in hardware/qcom-caf/common that only re-exports the
+        // kernel's generated usr/include. The global alias wins, and for a
+        // device with TARGET_FORCE_PREBUILT_KERNEL the generated headers do not
+        // contain the audio UAPI at all (they live in the separate -modules
+        // repo), so the include fails. Pointing at the headers directly avoids
+        // both a soong-namespace duplicate and a Make-level
+        // "MODULE.TARGET.HEADER_LIBRARIES.qti_audio_kernel_uapi already defined"
+        // clash, and does not disturb pdx257.
+        "kernel/sony/pdx246-modules/qcom/opensource/audio-kernel/include/uapi/audio",
     ],
 
     local_include_dirs: ["api"],
