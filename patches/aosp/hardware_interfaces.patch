-constexpr int kPullUpDelay = 500000;
+// Was 500000. That sleep mostly hid two races after adbd reopens FunctionFS
+// (USB bus reset, adbd restart): the endpoint files can come back before
+// MonitorFfs sees them missing, or while the kernel is still unbinding the old
+// gadget, and no later inotify event follows. MonitorFfs now reads the UDC
+// file and polls it (kPullUpRetryUs steps, up to kPullUpRetries after a seen
+// endpoint loss, kPullUpBoundPolls otherwise), so the device is back on the
+// bus without the extra half second and without adbd's 1 s bind timeout.
+constexpr int kPullUpDelay = 0;
+constexpr int kPullUpRetries = 100;
+constexpr int kPullUpBoundPolls = 30;
+constexpr int kPullUpRetryUs = 10000;
