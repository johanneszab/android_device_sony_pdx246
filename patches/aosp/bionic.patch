index f1b8eb06d..83ce1f564 100644
--- a/libc/bionic/spawn.cpp
+++ b/libc/bionic/spawn.cpp
@@ -28,6 +28,7 @@
 
 #include <spawn.h>
 
+#include <dirent.h>
 #include <errno.h>
 #include <fcntl.h>
 #include <linux/close_range.h>
@@ -114,6 +115,42 @@ struct __posix_spawnattr {
   } sigmask, sigdefault;
 };
 
+extern "C" int __getdents64(unsigned int, dirent*, unsigned int);
+
+// Marks every open fd >= min_fd close-on-exec by walking /proc/self/fd. This is
+// the fallback for kernels without CLOSE_RANGE_CLOEXEC (Linux < 5.11 without the
+// backport, such as the android12-5.10 GKI). It only makes system calls, so it is
+// safe in a vfork child.
+static bool SetCloexecFrom(int min_fd) {
+  int dir_fd = open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (dir_fd == -1) return false;
+
+  bool ok = true;
+  // Small, because bionic builds with -Wframe-larger-than=2048 and this gets inlined.
+  alignas(dirent) char buf[1024];
+  int n;
+  while ((n = TEMP_FAILURE_RETRY(
+              __getdents64(dir_fd, reinterpret_cast<dirent*>(buf), sizeof(buf)))) > 0) {
+    for (int pos = 0; pos < n;) {
+      dirent* entry = reinterpret_cast<dirent*>(buf + pos);
+      pos += entry->d_reclen;
+
+      const char* p = entry->d_name;
+      if (*p < '0' || *p > '9') continue;  // "." and ".."
+      int fd = 0;
+      for (; *p >= '0' && *p <= '9'; ++p) fd = fd * 10 + (*p - '0');
+      if (fd < min_fd || fd == dir_fd) continue;
+
+      int fd_flags = fcntl(fd, F_GETFD);
+      if (fd_flags == -1 || (fd_flags & FD_CLOEXEC) != 0) continue;
+      if (fcntl(fd, F_SETFD, fd_flags | FD_CLOEXEC) == -1) ok = false;
+    }
+  }
+  if (n == -1) ok = false;
+  close(dir_fd);
+  return ok;
+}
+
 static void ApplyAttrs(short flags, const posix_spawnattr_t* attr) {
   // POSIX: "If POSIX_SPAWN_SETSIGDEF is set ... signals in sigdefault ...
   // shall be set to their default actions in the child process."
@@ -154,7 +191,10 @@ static void ApplyAttrs(short flags, const posix_spawnattr_t* attr) {
 
   if ((flags & POSIX_SPAWN_CLOEXEC_DEFAULT) != 0) {
     // mark all open fds except stdin/out/err as close-on-exec
-    if (close_range(3, ~0U, CLOSE_RANGE_CLOEXEC)) _exit(127);
+    if (close_range(3, ~0U, CLOSE_RANGE_CLOEXEC) == -1) {
+      // Kernels without CLOSE_RANGE_CLOEXEC reject the flag with EINVAL.
+      if (errno != EINVAL || !SetCloexecFrom(3)) _exit(127);
+    }
   }
 }
 
