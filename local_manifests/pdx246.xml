<?xml version="1.0" encoding="UTF-8"?>
<!--
     Sony Xperia 10 VI (pdx246) for LineageOS 23.2.

     Copy this file to .repo/local_manifests/pdx246.xml in a LineageOS 23.2
     tree and run `repo sync`. See README.md for the full build instructions.

     The five projects below are everything this port needs on top of the
     LineageOS default manifest.

     Why the device tree and the three kernel repos need their own <remote>:
     roomservice (vendor/lineage/build/tools/roomservice.py) builds every
     project name as "LineageOS/<repository>", so lineage.dependencies can
     only ever name LineageOS-owned repos.

     Why hardware/sony is listed here even though lineage.dependencies also
     has it: BoardConfig.mk includes hardware/sony/sepolicy/qti/SEPolicy.mk,
     and that include is parsed while lunch checks the product - before
     roomservice could fetch it. Listing it here makes `repo sync` bring it
     in first.

     Why the paths say sm6450 while the kernel repos are named the same:
     SM6450 is this device's SoC. The kernel itself is a fork of LineageOS's
     android_kernel_sony_sm8450 (branch lineage-23.2 in that repo is the
     unchanged upstream; branch pdx246 carries this device's changes). The
     modules tree hardcodes the directory name sm6450-modules in its Kbuild
     and trace include paths, and the kernel reaches the device trees through
     a relative symlink, so none of these three paths can be renamed freely.
-->
<manifest>

  <remote name="johanneszab"
          fetch="https://github.com/johanneszab" />

  <project path="device/sony/pdx246"
           name="android_device_sony_pdx246"
           remote="johanneszab"
           revision="lineage-23.2" />

  <!-- TARGET_KERNEL_SOURCE points here. -->
  <project path="kernel/sony/sm6450"
           name="android_kernel_sony_sm6450"
           remote="johanneszab"
           revision="pdx246" />

  <!-- TARGET_KERNEL_EXT_MODULE_ROOT points here. -->
  <project path="kernel/sony/sm6450-modules"
           name="android_kernel_sony_sm6450-modules"
           remote="johanneszab"
           revision="lineage-23.2" />

  <!-- kernel/sony/sm6450/arch/arm64/boot/dts/vendor symlinks here. -->
  <project path="kernel/sony/sm6450-devicetrees"
           name="android_kernel_sony_sm6450-devicetrees"
           remote="johanneszab"
           revision="lineage-23.2" />

  <project path="hardware/sony"
           name="LineageOS/android_hardware_sony"
           remote="github" />

</manifest>
